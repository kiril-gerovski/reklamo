<?xml version="1.0"?>
<ruleset name="Reklamo">
	<description>WordPress Coding Standards for the Reklamo theme and plugin.</description>

	<file>wp-content/themes/reklamo</file>
	<file>wp-content/plugins/reklamo-core</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Site is bg_BG only; source strings are Bulgarian by design. -->
		<exclude name="WordPress.WP.I18n.NonSingularStringLiteralText"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="reklamo"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="reklamo"/>
				<element value="Reklamo"/>
				<element value="REKLAMO"/>
			</property>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
