# Copy to .env — never commit .env. Local-only values; the stack binds to 127.0.0.1.
# The main dev stack. Worktree stacks (scripts/worktree/wt-new.sh) get their own
# .env with a different project name and ports.
COMPOSE_PROJECT_NAME=reklamo
WP_PORT=8080
MAIL_PORT=8025

DB_NAME=reklamo
DB_USER=reklamo
DB_PASSWORD=reklamo-dev
DB_ROOT_PASSWORD=root-dev

WP_URL=http://localhost:8080
WP_TITLE=Reklamo.bg
WP_ADMIN_USER=admin
WP_ADMIN_PASS=reklamo-dev
WP_ADMIN_EMAIL=dev@reklamo.local

# Pin — scripts/setup.sh installs exactly this version; auto-updates are disabled.
WC_VERSION=11.1.0
