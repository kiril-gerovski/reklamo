# The hosting account's .env — lives in ~/reklamo/.env on the server, never committed.
# Copy to .env.server on your workstation (gitignored) and fill it in: scripts/deploy.sh
# install uploads it and install.sh merges it, so nothing is asked. Empty values are
# prompted for (or generated: DB_*, WP_ADMIN_PASS, SMTP_HOST). Uploading again with
# a changed value updates the server; an empty value never erases what is there.
# WordPress/WooCommerce version pins live in versions.env (committed).
REKLAMO_ENV=production

WP_URL=https://reklamo.bg
WP_TITLE=Reklamo.bg
WP_PATH=/home/CPANEL_USER/public_html
WP_ADMIN_USER=
# Empty: generated on first install and printed once.
WP_ADMIN_PASS=
WP_ADMIN_EMAIL=office@reklamo.bg

# PHP CLI binary matching the version chosen in cPanel → PHP Manager (the local stack runs
# the same major.minor). Use the full ea-phpXX path: `php` on PATH is whatever the server
# defaults to and moves without notice.
PHP_BIN=/opt/cpanel/ea-php85/root/usr/bin/php

# Left empty: install.sh creates database and user through cPanel's uapi.
# Filled in: an existing database created in cPanel → MySQL Databases.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# Customer logos and mockups — above the web root, never served.
REKLAMO_PRIVATE_DIR=/home/CPANEL_USER/reklamo-private

# Outgoing mail through a mailbox created in cPanel → Email Accounts.
# SMTP_HOST empty = the server's own hostname (serverNN.superhosting.bg), whose TLS
# certificate matches. 587/tls is what saturn accepts (465 is refused); 25 without
# encryption is the documented last resort. The sender address is forced to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=office@reklamo.bg
SMTP_PASS=

# Optional: server IP for the post-install web probe before DNS points at the account.
WP_HOST_IP=
