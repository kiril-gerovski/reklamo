<?xml version="1.0"?>
<ruleset name="Reklamo">
	<description>WordPress Coding Standards for the Reklamo theme and plugin.</description>

	<file>wp-content/themes/reklamo</file>
	<file>wp-content/plugins/reklamo-core</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.1-"/>

	<!-- Core + Extra (security, escaping, prepare, i18n). Not WordPress-Docs: docblock policing adds noise, not safety. -->
	<rule ref="WordPress-Extra">
		<!-- We fire WooCommerce's own hooks from our templates (woocommerce_email_header etc.); that is the API, not a naming slip. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_shop_orders"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="reklamo"/>
				<element value="reklamo-core"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="reklamo"/>
				<element value="Reklamo"/>
				<element value="REKLAMO"/>
			</property>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
