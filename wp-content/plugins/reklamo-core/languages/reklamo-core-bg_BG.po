msgstr "Здравейте, {customer_first_name}, получихме аванса Ви от {deposit_amount} — благодарим. Производството на пакета Ви започна. Ще Ви уведомим, когато е готов, и ще изпратим данните за остатъка от {balance_amount}."

#: includes/emails/class-reklamo-email-production-started.php:34
msgid "Questions? Just reply to this email."
msgstr "Въпроси? Просто отговорете на този имейл."

#: includes/emails/class-reklamo-email.php:61
msgid "Placeholders: {order_number}, {order_date}, {customer_first_name}, {site_title}, {deposit_amount}, {balance_amount}, {order_total}, {deposit_pct}, {revision}"
msgstr "Заместители: {order_number}, {order_date}, {customer_first_name}, {site_title}, {deposit_amount}, {balance_amount}, {order_total}, {deposit_pct}, {revision}"

#: templates/approval.php:127
