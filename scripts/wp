#!/usr/bin/env bash
# WP-CLI inside the stack. Usage: scripts/wp plugin list
# Reuses the helper container if a scripts/ script has one running.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f .env ] && { set -a; . ./.env; set +a; }
cli="${COMPOSE_PROJECT_NAME:-reklamo}-cli"
if docker ps -q -f name="^${cli}\$" | grep . >/dev/null; then
  exec docker exec -i "$cli" wp "$@"
fi
exec docker compose run --rm -T cli wp "$@"
